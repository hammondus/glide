// `let … else` must not fall off the end of its else block: the
// binding the `let` promises does not exist on that path. The shapes
// that do diverge are accept_let_else.gld.

fn no_control_flow(v: Int?) -> Int {
    let Some(n) = v else {  // error: must diverge
        println("absent")
    }
    n
}

fn half_a_branch(v: Int?, b: Bool) -> Int {
    // One-armed: the false path falls straight out of the block.
    let Some(n) = v else {  // error: must diverge
        if b { return 0 }
    }
    n
}

fn a_loop_body(v: Int?, ks: List<Int>) -> Int {
    // A loop whose body returns still falls through when it runs zero
    // times, so the return inside it proves nothing.
    let Some(n) = v else {  // error: must diverge
        for k in ks {
            return k
        }
    }
    n
}

fn breaks_out_of_the_loop(v: Int?) -> Int {
    // The loop runs forever only if nothing breaks out of it; this
    // break resumes right after the loop, at the end of the block.
    let Some(n) = v else {  // error: must diverge
        for {
            break
        }
    }
    n
}

fn breaks_out_by_label(v: Int?) -> Int {
    let Some(n) = v else {  // error: must diverge
        here: for {
            break here
        }
    }
    n
}

fn a_conditional_loop(v: Int?, b: Bool) -> Int {
    // A condition is a condition, however constant it looks: only the
    // conditionless form is treated as running forever.
    let Some(n) = v else {  // error: must diverge
        for b {
            println("waiting")
        }
    }
    n
}

fn main() {
    println(no_control_flow(1))
    println(half_a_branch(1, true))
    println(a_loop_body(1, [2]))
    println(breaks_out_of_the_loop(1))
    println(breaks_out_by_label(1))
    println(a_conditional_loop(1, true))
}
