// Sized numerics: literals must fit, and nothing converts implicitly.
fn wants_i32(n: i32) -> i32 { n }

fn main() {
    let a: u8 = 300         // error: 300 does not fit in u8
    let b: i8 = -129        // error: does not fit in i8
    let c: u8 = 255
    let d: Int = 7
    let e: u64 = -1         // error: -1 does not fit in u64
    let g: Int = 9223372036854775808   // error: 9223372036854775808 does not fit in Int
    println(e)
    println(g)
    println(wants_i32(d))   // error: expected i32, found Int
    println(a + c)
    println(b)
    println(d)

    // Widths do not mix, and the explicit escape hatch is no
    // exception: wrapping_add takes the receiver's own width.
    let h: u16 = 1
    println(c + h)          // error: operator + is not defined for u8 and u16
    println(c.wrapping_add(d))  // error: expected u8, found Int
    println(c.wrapping_add(h))  // error: expected u8, found u16
}
