// The numeric surface, split by one rule: **works at every width →
// method; Float-only or a constant → the `math` module.**
//
// abs, min, max and pow have to serve all nine numeric types. As
// methods the receiver binds `Self` through machinery that already
// runs; as free functions the checker would have to infer from one
// argument and unify an untyped literal against a later one, which it
// does nowhere else. Go's history corroborates: math.Min was
// float64-only because Go could not write it generically, and Go
// 1.21's fix was not a generic math.Min but universe *builtins* —
// which would be worse here, reserving `min` and `max` program-wide.
//
// Not permanent. When operator traits make a `Numeric` bound
// expressible, math.abs<T: Numeric> types itself and these can move.
import math

fn main() {
    // Self is the receiver's own type, at every width.
    let n: Int = (0 - 7).abs()
    let lo: Int = 5.min(3)
    let hi: Int = 5.max(3)
    let p: Int = 2.pow(10)
    println("{n} {lo} {hi} {p}")

    let a: i8 = -100
    let b: i8 = 4
    let narrow: i8 = a.abs()
    let bounded: i8 = a.max(b)
    let raised: i8 = b.pow(2)
    println("{narrow} {bounded} {raised}")

    // Unsigned types get min/max/pow but not abs — there is no sign
    // to remove, so offering it would read like one was handled.
    let u: u8 = 200
    let um: u8 = u.min(3)
    let big: u64 = 18446744073709551615
    let ub: u64 = big.max(1)
    println("{um} {ub}")

    // The exponent is an Int at every width: it counts
    // multiplications rather than being a value of the receiver type.
    let wide: u32 = 3
    let cubed: u32 = wide.pow(3)
    println("{cubed}")

    // Float gets the width-generic four too, with Self = Float.
    let f: Float = 2.5
    let e: Float = f.pow(2.0)
    println("{f.abs()} {f.min(1.0)} {f.max(1.0)} {e}")

    // Everything Float-*only* is in `math`, because a method earns its
    // place by needing the receiver to bind a width and these do not.
    let r: Float = math.round(f)
    let s: Float = math.sqrt(f)
    println("{math.floor(f)} {math.ceil(f)} {r} {math.trunc(f)} {s}")

    let isnan: Bool = math.is_nan(f)
    let isinf: Bool = math.is_infinite(f)
    let isfin: Bool = math.is_finite(f)
    println("{isnan} {isinf} {isfin}")

    // Constants: values, which a method could not express at all and
    // which a module could not hold until it learned to carry one.
    let circle: Float = math.pi * 2.0 * 2.0
    println("{circle} {math.e} {math.is_infinite(math.inf)} {math.is_nan(math.nan)}")

    // An untyped literal still adapts to Float, exactly as it does at
    // any other Float parameter — Go's math.Sqrt(9) rule.
    println("{math.sqrt(9)}")

    // Generic code reaches these through an Ord bound only for `cmp`;
    // the arithmetic ones are not trait methods, so they stay on the
    // concrete types. This is the sanity check that a concrete call
    // inside a generic function still resolves.
    println("{square(7)} {square(-7)}")
}

fn square(v: Int) -> Int { v.abs().pow(2) }
