// Sieve of Eratosthenes to 1,000,000 — benchmark against other interpreters.
fn main() {
    let n = 1_000_000

    // Int 1/0 rather than Bool so counting is a sum.
    let mut is_prime = [1].repeat(n + 1)
    is_prime[0] = 0
    is_prime[1] = 0

    let mut i = 2
    for i * i <= n {
        if is_prime[i] == 1 {
            let mut j = i * i
            for j <= n {
                is_prime[j] = 0
                j += i
            }
        }
        i += 1
    }

    println("glide primes={is_prime.iter().sum()}")
}
