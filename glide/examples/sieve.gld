// Sieve of Eratosthenes to 1,000,000 — benchmark against other interpreters.
fn main() {
    let n = 1_000_000

    // No fill-constructor in the M2 stdlib yet, so build the flag list
    // one push at a time. Int 1/0 rather than Bool so counting is a sum.
    let mut is_prime = []
    let mut k = 0
    for k <= n {
        is_prime.push(1)
        k += 1
    }
    is_prime[0] = 0
    is_prime[1] = 0

    let mut i = 2
    for i * i <= n {
        if is_prime[i] == 1 {
            let mut j = i * i
            for j <= n {
                is_prime[j] = 0
                j += i
            }
        }
        i += 1
    }

    let mut count = 0
    for f in is_prime {
        count += f
    }
    println("glide primes={count}")
}
